# ==============================================================================
# Fashion Atelier AI Platform (v3.1) — Local Development Environment
# ==============================================================================
NODE_ENV=development
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Application & Service Fixed Ports
# ------------------------------------------------------------------------------
STOREFRONT_PORT=3000
ADMIN_PORTAL_PORT=3001
PARTNER_PORTAL_PORT=3002

BFF_PORT=4000
AUTH_CUSTOMER_PORT=4001
CATALOG_LOOKBOOK_PORT=4002
MEDIA_PIPELINE_PORT=4003
INVENTORY_PORT=4004
CART_OUTFIT_PORT=4005
ORDER_RMA_PORT=4006
PAYMENT_PROMO_PORT=4007
NOTIFY_REVIEW_PORT=4008
AI_TRYON_PORT=4009
MCP_COPILOT_PORT=4010

# ------------------------------------------------------------------------------
# Public Frontend & Gateway URLs
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BFF_URL=http://localhost:4000
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_PORTAL_URL=http://localhost:3001
NEXT_PUBLIC_PARTNER_PORTAL_URL=http://localhost:3002
# Gate quick-fill dev login buttons & default demo credentials on Admin/Partner portals.
# Production MUST keep this set to `false` (never expose demo passwords in production builds).
NEXT_PUBLIC_ENABLE_DEV_LOGIN=false
STOREFRONT_URL=http://127.0.0.1:3000
INVENTORY_SERVICE_URL=http://127.0.0.1:4004
CART_OUTFIT_SERVICE_URL=http://127.0.0.1:4005
ORDER_RMA_SERVICE_URL=http://127.0.0.1:4006
PAYMENT_PROMO_SERVICE_URL=http://127.0.0.1:4007
NOTIFY_REVIEW_SERVICE_URL=http://127.0.0.1:4008
REVALIDATE_SECRET=Atelier_Isr_Revalidate_2026!
INTERNAL_SERVICE_SECRET=Atelier_Internal_Svc_2026!
VIETQR_WEBHOOK_SECRET=Atelier_VietQR_Hmac_2026!
VNPAY_WEBHOOK_SECRET=Atelier_VNPay_Hmac_2026!
MOMO_WEBHOOK_SECRET=Atelier_MoMo_Hmac_2026!
SUPPLIER_A_ID=11111111-1111-4111-8111-111111111101
SUPPLIER_B_ID=22222222-2222-4222-8222-222222222202
SUPPLIER_C_ID=33333333-3333-4333-8333-333333333303
AI_TRYON_SERVICE_URL=http://127.0.0.1:4009
MCP_COPILOT_URL=http://127.0.0.1:4010
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002,https://localhost,https://admin.localhost,https://partner.localhost

