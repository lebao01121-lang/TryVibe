{
  "name": "@atelier/bff",
  "version": "3.0.0",
  "private": true,
  "description": "Zero-Trust API Gateway, 3-Branch Fashion BFF and Socket.io Realtime Hub for Fashion Atelier AI Platform",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
