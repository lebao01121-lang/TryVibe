# ------------------------------------------------------------------------------
# Redis 7 & Socket.io Multi-Instance Adapter
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=Atelier_Redis2026!
REDIS_URL=redis://:Atelier_Redis2026!@127.0.0.1:6379
# Set to `false` to disable @socket.io/redis-adapter and stay on in-memory adapter
SOCKET_IO_REDIS_ENABLED=true

# ------------------------------------------------------------------------------
# Meilisearch
# ------------------------------------------------------------------------------
MEILISEARCH_PORT=7700
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_MASTER_KEY=Atelier_Meili_Master_2026_Key

# ------------------------------------------------------------------------------
# RabbitMQ 3.13
# ------------------------------------------------------------------------------
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_MGMT_URL=http://127.0.0.1:15672
RABBITMQ_USER=atelier_mq
RABBITMQ_PASSWORD=Atelier_Mq2026!
RABBITMQ_URL=amqp://atelier_mq:Atelier_Mq2026!@127.0.0.1:5672

# ------------------------------------------------------------------------------
# MinIO Object Storage (3 Segregated Buckets)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=atelier_minio
MINIO_ROOT_PASSWORD=Atelier_Minio2026!
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://127.0.0.1:9000
MINIO_BUCKET_PUBLIC=atelier-public
MINIO_BUCKET_GARMENTS=atelier-garments
MINIO_BUCKET_PRIVATE_TRYON=atelier-private-tryon

# ------------------------------------------------------------------------------
# Email SMTP (Mặc định Mailpit Local :1025 / UI :8025 · Hỗ trợ Gmail SMTP thật)
# ------------------------------------------------------------------------------
MAILPIT_HOST=127.0.0.1
MAILPIT_UI_PORT=8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=atelier@fashion-atelier.local
#
# --- Mẫu cấu hình gửi OTP 2FA & Email thật qua Gmail SMTP (STARTTLS :587 hoặc SSL :465) ---
# 1. Bật Xác minh 2 bước (2-Step Verification) trên tài khoản Google của bạn.
# 2. Tạo App Password 16 ký tự tại: https://myaccount.google.com/apppasswords
# 3. Bỏ dấu # các dòng bên dưới, điền App Password và khởi động lại auth-customer (:4001) & notify-review (:4008).
#    (Giữ nguyên MAILPIT_HOST=127.0.0.1 để BFF healthcheck vẫn kiểm tra Mailpit cục bộ ổn định.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=lebao01121@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM="TryVibe Fashion Atelier <lebao01121@gmail.com>"

# ------------------------------------------------------------------------------
# Nginx Local TLS Reverse Proxy
# ------------------------------------------------------------------------------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ------------------------------------------------------------------------------
# AI Copilot (100% Local Ollama) & Virtual Try-On (Offline-Safe Defaults)
# ------------------------------------------------------------------------------
AI_PROVIDER=ollama
# Host Ollama endpoint (auto-switches to http://host.docker.internal:11434 inside Docker containers)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Use `qwen2.5:3b` on <= 16GB RAM hosts; auto-selected when free RAM < 6GB
OLLAMA_MAIN_MODEL=qwen2.5:7b
OLLAMA_FAST_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_DIM=768
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_MS=30000
# Virtual Try-On Stage 2 — 4-Tier VTON Provider Chain & D: Drive Isolation
# TRYON_PROVIDER=auto: FAL / FASHN (Tier 1) -> Local LAN GPU (Tier 3) -> HF ZeroGPU (Tier 2) -> Photometric Inpaint (Tier 4)
TRYON_PROVIDER=auto
VTON_PROVIDER=auto
FAL_KEY=
FAL_VTON_MODEL=fal-ai/cat-vton
FASHN_API_KEY=
HF_TOKEN=
HF_VTON_TIMEOUT_SECONDS=40
LOCAL_VTON_ENDPOINT=
TRYON_TMP_DIR=D:\doancosothue\TryVibe\.project-data\tmp
TRYON_MODELS_DIR=D:\doancosothue\TryVibe\.project-data\ai-models

# ------------------------------------------------------------------------------
# Auth / JWT (Local Development Only)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=atelier_local_dev_jwt_access_secret_2026_do_not_use_in_prod
JWT_REFRESH_SECRET=atelier_local_dev_jwt_refresh_secret_2026_do_not_use_in_prod

