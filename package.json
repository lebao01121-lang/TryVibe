{
  "name": "fashion-atelier-ai-platform",
  "version": "3.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "eval:ai": "pnpm --filter @atelier/ai-harness eval",
    "infra:certs": "node infra/nginx/setup-certs.mjs",
    "infra:local-dev": "node scripts/local-infra-dev.mjs",
    "verify:phase0": "node scripts/verify-phase0.mjs",
    "verify:phase1": "node scripts/verify-phase1.mjs",
    "verify:phase2": "node scripts/verify-phase2.mjs",
    "verify:phase3": "node scripts/verify-phase3.mjs",
    "verify:phase4": "node scripts/verify-phase4.mjs",
    "verify:phase5": "node scripts/verify-phase5.mjs",
    "verify:ui": "node scripts/verify-ui-atelier.mjs",
    "test:flash-sale": "node scripts/stress-flash-sale.mjs",
    "ai:export-sft": "node scripts/export-ai-preference-dataset.mjs",
    "db:seed": "node infra/seeds/seed-demo-data.mjs",
    "demo:ready": "node scripts/demo-ready.mjs",
    "start:all": "node scripts/start-all.mjs",
    "verify:all": "node scripts/verify-all.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "playwright-core": "^1.52.0",
    "prettier": "^3.5.3",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.4",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
